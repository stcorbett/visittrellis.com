<% page title: "Page not found", description: "That page isn't on visittrellis.com.", absolute_links: true %>
<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <div class="max-w-2xl space-y-6">
    <h1 class="font-display text-4xl text-ink sm:text-5xl">We couldn't find that page.</h1>
    <p class="text-lg text-ink-muted">
      Looking for your network? Trellis itself lives at
      <a class="link-warm" href="<%= Site::APP %>">app.visittrellis.com</a>.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="<%= Site::SIGN_IN %>" class="btn-warm-primary">Sign in to Trellis</a>
      <a href="<%= path %>" class="btn-warm-ghost">Go to the home page</a>
    </div>
  </div>
</section>
