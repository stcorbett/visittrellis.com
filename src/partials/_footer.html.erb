<footer class="mt-24 border-t border-coral-100 bg-white/60">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-ink-muted sm:flex-row sm:items-start sm:justify-between sm:px-6">
    <div class="space-y-2">
      <a href="<%= path %>" class="flex items-center gap-2">
        <%= partial "logo", size: "h-6 w-6" %>
        <span class="font-display text-lg text-ink">Trellis</span>
      </a>
      <p>Empowering you to create in community.</p>
      <p>© <%= Time.now.year %> <a href="<%= Site::COMPANY_URL %>" class="hover:text-ink hover:underline"><%= Site::COMPANY %></a></p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-2">
      <a href="<%= Site::SIGN_UP %>" class="hover:text-ink hover:underline">Start your network</a>
      <a href="<%= path("customers/") %>" class="hover:text-ink hover:underline">Customers</a>
      <a href="<%= Site::SIGN_IN %>" class="hover:text-ink hover:underline">Sign in</a>
      <a href="<%= path("terms/") %>" class="hover:text-ink hover:underline">Terms of service</a>
      <a href="mailto:<%= Site::CONTACT_EMAIL %>" class="hover:text-ink hover:underline"><%= Site::CONTACT_EMAIL %></a>
      <a href="<%= path("privacy/") %>" class="hover:text-ink hover:underline">Privacy policy</a>
    </nav>
  </div>
</footer>
